{
  "schemaVersion": 1,
  "id": "io.github.anishfn.omara",
  "name": "Workspace Modes",
  "version": "1.0.0",
  "author": "anishfn",
  "license": "MIT",
  "description": "Switch your whole Omarchy desktop into the way you work: which apps open on which workspaces and in what layout, plus notifications, audio, wallpaper, theme and commands — one mode at a time.",
  "repository": "https://github.com/anishfn/omara",
  "keywords": [
    "productivity",
    "workspace",
    "automation",
    "desktop",
    "modes",
    "workflow",
    "quickshell"
  ],
  "kinds": [
    "bar-widget",
    "service"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml",
    "service": "Service.qml"
  },
  "barWidget": {
    "displayName": "Workspace Modes",
    "description": "Show the workspace mode you are in, and switch between them.",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "left",
    "defaults": {
      "showIcon": true,
      "showName": true
    },
    "schema": [
      {
        "key": "showIcon",
        "type": "boolean",
        "label": "Show the mode icon",
        "defaultValue": true
      },
      {
        "key": "showName",
        "type": "boolean",
        "label": "Show the mode name",
        "defaultValue": true
      }
    ]
  }
}
